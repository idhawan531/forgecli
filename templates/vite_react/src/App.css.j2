:root {
  color-scheme: dark;
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top, #16203a, #0b1020 55%);
  color: #e7e9ee;
}

.app {
  min-height: 100vh;
  display: grid;
  place-content: center;
  text-align: center;
  padding: 2rem;
}

h1 {
  font-size: clamp(1.7rem, 4vw, 2.8rem);
  margin-bottom: 0.75rem;
}

p {
  margin: 0;
  color: #b8c0d0;
}
